<UserControl
    x:Class="HyperVProxyManager.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:p="clr-namespace:HyperVProxyManager.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewmodels="clr-namespace:HyperVProxyManager.ViewModels">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  头部：返回按钮和标题  -->
        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,24"
            Orientation="Horizontal">
            <ui:Button
                Appearance="Transparent"
                Command="{Binding GoBackCommand}"
                Icon="{ui:SymbolIcon ArrowLeft24}" />

            <TextBlock
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{x:Static p:l10n.SettingsTitle}" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <!--  设置卡片  -->
            <StackPanel HorizontalAlignment="Stretch">
                <ui:Card
                    Padding="12"
                    Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="14"
                                FontWeight="Medium"
                                Text="{x:Static p:l10n.SettingsCustomHeader}" />

                            <TextBlock
                                FontSize="12"
                                Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Static p:l10n.SettingsCustomDescription}" />
                        </StackPanel>

                        <ui:ToggleSwitch
                            Grid.Column="1"
                            IsChecked="{Binding UseExternalConfig, Mode=TwoWay}" />
                    </Grid>

                </ui:Card>

                <ui:Card
                    Padding="12"
                    Background="{ui:ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center">
                            <TextBlock Text="{x:Static p:l10n.SettingsPortHeader}" />

                            <TextBlock
                                FontSize="12"
                                Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Static p:l10n.SettingsPortDescription}" />
                        </StackPanel>

                        <ui:NumberBox
                            Grid.Column="1"
                            IsEnabled="{Binding UseExternalConfig}"
                            Maximum="65535"
                            Minimum="1"
                            Value="{Binding ProxyPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </ui:Card>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>