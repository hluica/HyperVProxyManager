<UserControl
    x:Class="HyperVProxyManager.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewmodels="clr-namespace:HyperVProxyManager.ViewModels">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  头部：返回按钮和标题  -->
        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,24"
            Orientation="Horizontal">
            <ui:Button
                Appearance="Secondary"
                Command="{Binding GoBackCommand}"
                Icon="{ui:SymbolIcon ArrowLeft24}" />

            <TextBlock
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="SemiBold"
                Text="设置" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <!--  设置卡片  -->
            <ui:CardExpander
                HorizontalAlignment="Stretch"
                IsExpanded="True">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="14"
                                FontWeight="Medium"
                                Text="自定义配置" />

                            <TextBlock
                                FontSize="12"
                                Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                Text="是否从外部 config.ini 读取代理端口配置" />
                        </StackPanel>

                        <!--  Header 开关  -->
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            IsChecked="{Binding UseExternalConfig, Mode=TwoWay}" />
                    </Grid>
                </ui:CardExpander.Header>

                <!--  Content: 端口设置  -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center">
                        <TextBlock Text="代理端口" />

                        <TextBlock
                            FontSize="12"
                            Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                            Text="指定宿主机代理软件监听的端口 (1-65535)" />
                    </StackPanel>

                    <ui:NumberBox
                        Grid.Column="1"
                        IsEnabled="{Binding UseExternalConfig}"
                        Maximum="65535"
                        Minimum="1"
                        Value="{Binding ProxyPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </ui:CardExpander>
        </StackPanel>
    </Grid>
</UserControl>