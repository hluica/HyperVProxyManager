<tb:TaskbarIcon
    x:Class="HyperVProxyManager.Tray.TrayIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="http://www.hardcodet.net/taskbar"
    xmlns:vm="clr-namespace:HyperVProxyManager.ViewModels"
    ToolTipText="虚拟机代理控制"
    TrayLeftMouseUp="OnLeftClick">

    <tb:TaskbarIcon.ContextMenu>
        <ContextMenu
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">
            <!--  第一部分：状态显示  -->
            <MenuItem
                Focusable="False"
                IsHitTestVisible="False">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse
                            Width="12"
                            Height="12"
                            Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#737373" />
                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsProxyEnabled}"
                                            Value="True">
                                            <Setter Property="Fill" Value="#00CC6A" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <TextBlock Text="{Binding CurrentProxyAddress}" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>

            <Separator />

            <!--  第二部分：操作  -->
            <MenuItem
                Command="{Binding QuickSetCommand}"
                Header="快速应用"
                IsEnabled="{Binding CanQuickSet}" />

            <MenuItem
                Command="{Binding DisableProxyCommand}"
                Header="禁用"
                IsEnabled="{Binding IsProxyEnabled}" />

            <Separator />

            <!--  第三部分：界面  -->
            <MenuItem
                Click="OnShowWindow"
                Header="打开主界面" />
            <MenuItem
                Click="OnExit"
                Header="退出程序" />
        </ContextMenu>
    </tb:TaskbarIcon.ContextMenu>
</tb:TaskbarIcon>
