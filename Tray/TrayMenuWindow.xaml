<Window
    x:Class="HyperVProxyManager.Tray.TrayMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="220"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Topmost="True"
    Visibility="Collapsed"
    WindowStyle="None">

    <StackPanel Margin="4">
        <!--  状态信息区  -->
        <ui:Card VerticalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Ellipse
                    Grid.Column="0"
                    Width="12"
                    Height="12"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#737373" />
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsProxyEnabled}"
                                    Value="True">
                                    <Setter Property="Fill" Value="#00CC6A" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                    Text="{Binding ProxyStatusText}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </ui:Card>

        <Separator Margin="2,3" />

        <!--  操作按钮  -->
        <ui:Button
            Height="34"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            Appearance="Transparent"
            Command="{Binding QuickSetCommand}"
            IsEnabled="{Binding CanQuickSet}">
            <ui:Button.Icon>
                <ui:SymbolIcon Symbol="Rocket24" />
            </ui:Button.Icon>
            快速应用
        </ui:Button>

        <ui:Button
            Height="34"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            Appearance="Transparent"
            Command="{Binding DisableProxyCommand}"
            IsEnabled="{Binding IsProxyEnabled}">
            <ui:Button.Icon>
                <ui:SymbolIcon Symbol="DismissCircle24" />
            </ui:Button.Icon>
            禁用代理
        </ui:Button>

        <Separator Margin="2,3" />

        <!--  系统操作  -->
        <ui:Button
            Height="34"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            Appearance="Transparent"
            Command="{Binding ShowMainWindowCommand}">
            <ui:Button.Icon>
                <ui:SymbolIcon Symbol="Window24" />
            </ui:Button.Icon>
            打开主界面
        </ui:Button>

        <ui:Button
            Height="34"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            Appearance="Transparent"
            Command="{Binding ExitCommand}">
            <ui:Button.Icon>
                <ui:SymbolIcon Symbol="Power24" />
            </ui:Button.Icon>
            退出程序
        </ui:Button>
    </StackPanel>
</Window>
